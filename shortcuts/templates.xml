<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <template include="submenu-widget" build="true" menu="mainmenu">
        <controls>
            <control type="wraplist" id="9001">
                <visible>Integer.IsEqual(Window(Home).Property(MenuFocus),9002) + [!String.IsEmpty(Container(9002).ListItem.Property(widget)) | !String.IsEmpty(Container(9002).ListItem.Property(widgetPath))]</visible>
                <visible>!Player.HasVideo | [Player.HasVideo + !Skin.HasSetting(background.showvideo)]</visible>
                <orientation>horizontal</orientation>
                <width>100%</width>
                <top>top</top>
                <height>height</height>
                <onfocus>SetProperty(FO9001,1,home)</onfocus>
                <onunfocus>ClearProperty(FO9001,home)</onunfocus>
                <onup>ClearProperty(FO9001,home)</onup>
                <ondown>ClearProperty(FO9001,home)</ondown>
                <onback>ClearProperty(FO9001,home)</onback>
                <onback>9000</onback>
                <ondown>9000</ondown>
                <onup>SetFocus(9002)</onup>
                <onclick condition="String.IsEqual(Container(9002).ListItem.Property(widget),Weather)">ActivateWindow(weather)</onclick>
                <autoscroll time="8000">![Control.HasFocus(9001) | Control.HasFocus(9101)]</autoscroll>
                <scrolltime tween="sine" easing="out">240</scrolltime>
                <itemlayout />
                <focusedlayout width="1920" height="1080" />
                <content target="$INFO[Container(9002).ListItem.Property(widgetTarget)]">$INFO[Container(9002).ListItem.Property(widgetPath)]</content>
                <!-- Auto-play Trailers Logic -->
                <onitemfocused condition="Skin.HasSetting(home.autoplaytrailers)">CancelAlarm(AutoPlayTrailer)</onitemfocused>
                <onitemfocused condition="Skin.HasSetting(home.autoplaytrailers) + !String.IsEmpty(ListItem.Trailer)">AlarmClock(AutoPlayTrailer,PlayMedia($INFO[ListItem.Trailer],0,noresume),00:$INFO[Skin.String(home.autoplaytrailers.delay)],silent)</onitemfocused>
            </control>
        </controls>
    </template>

    <template include="widget" build="true" menu="mainmenu">
        <property name="content" condition="widget=Weather">$INFO[Window(Weather).Property(Current.FanartCode),resource://resource.images.weatherfanart.multi/,]/</property>
        <property name="content" condition="!widget=Weather + widgetPath" from="widgetPath" />
        <property name="content" condition="!widget=Weather + !widgetPath">$VAR[Defs_HomeWidget_Content]</property>
        <property name="target" condition="widget=Weather">images</property>
        <property name="target" condition="!widget=Weather + widgetTarget" from="widgetTarget" />
        <property name="target" condition="!widget=Weather + !widgetTarget">$VAR[Defs_HomeWidget_Target]</property>
        <property name="isWeather" condition="widget=Weather">True</property>
        <property name="isWeather" condition="!widget=Weather">False</property>
        <controls>
            <control type="wraplist" id="9001">
                <visible>!Integer.IsEqual(Window(Home).Property(MenuFocus),9002) | [String.IsEmpty(Container(9002).ListItem.Property(widget)) + String.IsEmpty(Container(9002).ListItem.Property(widgetPath))]</visible>
                <skinshortcuts>visibility</skinshortcuts>
                <visible>!Player.HasVideo | [Player.HasVideo + !Skin.HasSetting(background.showvideo)]</visible>
                <orientation>horizontal</orientation>
                <width>100%</width>
                <top>top</top>
                <height>height</height>
                <onfocus>SetProperty(FO9001,1,home)</onfocus>
                <onunfocus>ClearProperty(FO9001,home)</onunfocus>
                <onup>ClearProperty(FO9001,home)</onup>
                <ondown>ClearProperty(FO9001,home)</ondown>
                <onback>ClearProperty(FO9001,home)</onback>
                <onback>9000</onback>
                <ondown>9000</ondown>
                <onup>SetFocus(9002)</onup>
                <include condition="$PROPERTY[isWeather]">Defs_WeatherOpen</include>
                <autoscroll time="8000">![Control.HasFocus(9001) | Control.HasFocus(9101)]</autoscroll>
                <scrolltime tween="sine" easing="out">240</scrolltime>
                <itemlayout />
                <focusedlayout width="1920" height="1080" />
                <content target="$PROPERTY[target]">$PROPERTY[content]</content>
                <!-- Auto-play Trailers Logic -->
                <onitemfocused condition="Skin.HasSetting(home.autoplaytrailers)">CancelAlarm(AutoPlayTrailer)</onitemfocused>
                <onitemfocused condition="Skin.HasSetting(home.autoplaytrailers) + !String.IsEmpty(ListItem.Trailer)">AlarmClock(AutoPlayTrailer,PlayMedia($INFO[ListItem.Trailer],0,noresume),00:$INFO[Skin.String(home.autoplaytrailers.delay)],silent)</onitemfocused>
            </control>
        </controls>
    </template>
</templates>
