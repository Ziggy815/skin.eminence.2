<?xml version="1.0" encoding="UTF-8"?>
<window>
    <!-- contextmenu -->
    <defaultcontrol always="true">996</defaultcontrol>
    <coordinates>
        <origin x="0" y="0"/>
    </coordinates>

    <controls>
        <control type="group">
            <include condition="!Skin.HasSetting(HorizontalMenus)">GlobalOverlay</include>
            <include condition="!Skin.HasSetting(HorizontalMenus)">Dialog_Center</include>
            <include>Animation_FadeIn</include>
            <include>Animation_FadeOut</include>
        </control>
        <control type="group">

            <include condition="!Skin.HasSetting(HorizontalMenus)">Dialog_Center_Def</include>
            <include condition="Skin.HasSetting(HorizontalMenus)">Dialog_Top</include>
            <include condition="Skin.HasSetting(HorizontalMenus)">Dialog_Background</include>
            <control type="image" id="999">
                <include condition="!Skin.HasSetting(HorizontalMenus)">Dialog_Center_Background</include>
            </control>

            <include content="Dialog_Top_IconHeader">
                <param name="label" value="$LOCALIZE[31069]" />
                <param name="icon" value="special://skin/extras/icons/settings.png" />
            </include>
            <include content="Dialog_Center_Arrows" condition="!Skin.HasSetting(HorizontalMenus)">
                <param name="id" value="996" />
            </include>
            <include content="Dialog_Top_Arrows" condition="Skin.HasSetting(HorizontalMenus)">
                <param name="id" value="996" />
            </include>

            <!-- Default GroupList -->
            <control type="grouplist" id="996">
                <onup condition="!Skin.HasSetting(HorizontalMenus)">996</onup>
                <ondown condition="!Skin.HasSetting(HorizontalMenus)">996</ondown>
                <onleft condition="!Skin.HasSetting(HorizontalMenus)">Close</onleft>
                <onright condition="!Skin.HasSetting(HorizontalMenus)">Close</onright>
                <include condition="!Skin.HasSetting(HorizontalMenus)">Dialog_Center_GroupList</include>
                <onup condition="Skin.HasSetting(HorizontalMenus)">Close</onup>
                <ondown condition="Skin.HasSetting(HorizontalMenus)">Close</ondown>
                <include condition="Skin.HasSetting(HorizontalMenus)">Dialog_Top_GroupList</include>

                <!-- Default Button Template -->
                <control type="button" id="1000">
                    <include condition="!Skin.HasSetting(HorizontalMenus)">Defs_OptionButton2_Horz</include>
                    <include condition="Skin.HasSetting(HorizontalMenus)">Defs_OptionButton2</include>
                </control>

                <!-- TMDbHelper Extended Info Button -->
                <control type="button" id="997">
                    <visible>System.HasAddon(plugin.video.themoviedb.helper) + !ListItem.IsParentFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,actor) | String.IsEqual(ListItem.DBType,director)]</visible>
                    <label>TMDb Helper - $LOCALIZE[29915]</label>
                    <include condition="!Skin.HasSetting(HorizontalMenus)">Defs_OptionButton2_Horz</include>
                    <include condition="Skin.HasSetting(HorizontalMenus)">Defs_OptionButton2</include>
                    <onclick>SetProperty(extinfo,2,home)</onclick>
                    <onclick>SetProperty(1190_MainLabel,$VAR[Furniture_TopBar_Header_MainLabel],home)</onclick>
                    <onclick>SetProperty(1190_SubLabel,$VAR[Furniture_TopBar_Header_SubLabel],home)</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,movie) + !String.IsEmpty(ListItem.UniqueID(tmdb))">RunScript(plugin.video.themoviedb.helper,add_tmdb=$INFO[ListItem.UniqueID(tmdb)],tmdb_type=movie,call_auto=1190)</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,movie) + String.IsEmpty(ListItem.UniqueID(tmdb))">RunScript(plugin.video.themoviedb.helper,add_query=$INFO[ListItem.Title],tmdb_type=movie,call_auto=1190)</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.UniqueID(tmdb))">RunScript(plugin.video.themoviedb.helper,add_tmdb=$INFO[ListItem.UniqueID(tmdb)],tmdb_type=tv,call_auto=1190)</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,tvshow) + String.IsEmpty(ListItem.UniqueID(tmdb))">RunScript(plugin.video.themoviedb.helper,add_query=$INFO[ListItem.Title],tmdb_type=tv,call_auto=1190)</onclick>
                    <onclick condition="[String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)] + !String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))">RunScript(plugin.video.themoviedb.helper,add_tmdb=$INFO[ListItem.UniqueID(tvshow.tmdb)],tmdb_type=tv,call_auto=1190)</onclick>
                    <onclick condition="[String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)] + String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))">RunScript(plugin.video.themoviedb.helper,add_query=$INFO[ListItem.TvShowTitle],tmdb_type=tv,call_auto=1190)</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,actor) | String.IsEqual(ListItem.DBType,director)">RunScript(plugin.video.themoviedb.helper,add_query=$INFO[ListItem.Label],tmdb_type=person,call_auto=1190)</onclick>
                </control>

                <!-- TMDbHelper Related Lists Menu Button -->
                <control type="button" id="998">
                    <visible>System.HasAddon(plugin.video.themoviedb.helper) + !ListItem.IsParentFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,actor) | String.IsEqual(ListItem.DBType,director)]</visible>
                    <label>TMDb Helper - $LOCALIZE[31069]</label>
                    <include condition="!Skin.HasSetting(HorizontalMenus)">Defs_OptionButton2_Horz</include>
                    <include condition="Skin.HasSetting(HorizontalMenus)">Defs_OptionButton2</include>
                    <onclick condition="String.IsEqual(ListItem.DBType,movie)">RunScript(plugin.video.themoviedb.helper,related_lists,tmdb_type=movie,tmdb_id=$INFO[ListItem.UniqueID(tmdb)],imdb_id=$INFO[ListItem.IMDBNumber],query=$INFO[ListItem.Title],year=$INFO[ListItem.Year])</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,tvshow)">RunScript(plugin.video.themoviedb.helper,related_lists,tmdb_type=tv,tmdb_id=$INFO[ListItem.UniqueID(tmdb)],tvdb_id=$INFO[ListItem.UniqueID(tvdb)],query=$INFO[ListItem.Title],year=$INFO[ListItem.Year])</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)">RunScript(plugin.video.themoviedb.helper,related_lists,tmdb_type=tv,tmdb_id=$INFO[ListItem.UniqueID(tvshow.tmdb)],query=$INFO[ListItem.TvShowTitle],season=$INFO[ListItem.Season],episode=$INFO[ListItem.Episode])</onclick>
                    <onclick condition="String.IsEqual(ListItem.DBType,actor) | String.IsEqual(ListItem.DBType,director)">RunScript(plugin.video.themoviedb.helper,related_lists,tmdb_type=person,query=$INFO[ListItem.Label])</onclick>
                </control>
            </control>
        </control>

    </controls>

</window>