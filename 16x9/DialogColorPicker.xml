<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">6</defaultcontrol>
    <controls>
        <include>GlobalOverlay</include>
        <control type="group">
            <include>Animation_SlideIn</include>
            <include>Animation_FadeOut</include>
            <centerleft>50%</centerleft>
            <width>1160</width>
            <bottom>150</bottom>
            <height>600</height>
            <include>Dialog_Background</include>
            <include content="Dialog_Top_IconHeader">
                <param name="label" value="$INFO[Control.GetLabel(1)]$INFO[Container(6).ListItem.Label, - ,]$INFO[Container(6).ListItem.Label2, (#,)]" />
                <param name="icon" value="special://skin/extras/icons/paintbrush.png" />
            </include>
            <control type="label" id="1">
                <visible>false</visible>
            </control>

            <!-- Color picker panel -->
            <control type="panel" id="6">
                <left>bigpad</left>
                <right>bigpad</right>
                <top>80</top>
                <bottom>102</bottom>
                <onup>6</onup>
                <ondown>9001</ondown>
                <onleft>6</onleft>
                <onright>61</onright>
                <orientation>vertical</orientation>
                <pagecontrol>61</pagecontrol>
                <itemlayout width="140" height="100">
                    <control type="group">
                        <top>8</top>
                        <bottom>8</bottom>
                        <left>8</left>
                        <right>8</right>
                        <include>Object_FlatBackground</include>
                        <control type="image">
                            <texture>common/white.png</texture>
                            <colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
                            <bordersize>8</bordersize>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout width="140" height="100">
                    <control type="group">
                        <top>8</top>
                        <bottom>8</bottom>
                        <left>8</left>
                        <right>8</right>
                        <include>Object_FlatBackground</include>
                        <control type="image">
                            <texture>common/white.png</texture>
                            <colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
                            <bordersize>0</bordersize>
                        </control>
                    </control>
                </focusedlayout>
            </control>

            <control type="scrollbar" id="61">
                <right>8</right>
                <top>88</top>
                <width>8</width>
                <bottom>110</bottom>
                <onleft>6</onleft>
                <onright>9001</onright>
                <orientation>vertical</orientation>
            </control>

            <control type="grouplist" id="9001">
                <centerleft>50%</centerleft>
                <width>1120</width>
                <bottom>bigpad</bottom>
                <height>64</height>
                <align>center</align>
                <itemgap>20</itemgap>
                <onup>6</onup>
                <ondown>6</ondown>
                <orientation>horizontal</orientation>
                <control type="button" id="7">
                    <align>center</align>
                    <width>300</width>
                    <label>$LOCALIZE[222]</label>
                    <include>Defs_OptionButton2</include>
                </control>
            </control>
        </control>
    </controls>
</window>
