<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <controls>
        <!-- TopBar & Hintergrund-Abdunklung wie in MyPVRChannels -->
	<include>Furniture_Background</include>
	<include>Furniture_RSS</include>
        <include>Furniture_TopBar</include>

        <control type="group">
            <visible>!Window.IsActive(DialogPVRGuideInfo.xml)</visible>
            <include>Defs_ViewBackground</include>
            <include content="Object_Headline">
                <param name="label" value="$INFO[VideoPlayer.ChannelGroup] ($INFO[Container(11).NumItems] $LOCALIZE[19019])" />
            </include>

            <control type="group">
                <include>Animation_Common</include>
                <include>Animation_FadeIn</include>
                <include>Animation_FadeOut</include>
                <left>bigpad</left>
                <right>bigpad</right>
                <top>bigpad</top>
                <height>posterh</height>

                <!-- LINKER BEREICH: Große Senderliste (ID 11) -->
                <control type="group">
                    <width>listinfow</width>
                    <include>Object_Background</include>
                    <control type="panel" id="11">
                        <width>listinfow</width>
                        <height>720</height>
                        <onup>11</onup>
                        <ondown>11</ondown>
                        <onleft>PreviousChannelGroup</onleft>
                        <onright>NextChannelGroup</onright>
                        <pagecontrol>60</pagecontrol>
                        <preloaditems>2</preloaditems>
                        <orientation>vertical</orientation>
                        <scrolltime tween="quadratic">400</scrolltime>

                        <itemlayout height="144" width="listinfow">
                            <control type="group">
                                <left>0</left>
                                <right>0</right>
                                <control type="image">
                                    <texture colordiffuse="0fffffff">common/selected.png</texture>
                                    <aspectratio>scale</aspectratio>
                                    <visible>ListItem.IsPlaying</visible>
                                </control>
                                <control type="image">
                                    <left>bigpad</left>
                                    <width>104</width>
                                    <top>bigpad</top>
                                    <bottom>bigpad</bottom>
                                    <aspectratio>keep</aspectratio>
                                    <texture background="true">$INFO[ListItem.Icon]</texture>
                                    <visible>!String.IsEmpty(ListItem.Icon)</visible>
                                </control>
                                <control type="image">
                                    <left>bigpad</left>
                                    <width>104</width>
                                    <top>bigpad</top>
                                    <bottom>bigpad</bottom>
                                    <aspectratio>keep</aspectratio>
                                    <texture background="true">$INFO[ListItem.Thumb]</texture>
                                    <visible>String.IsEmpty(ListItem.Icon)</visible>
                                </control>
                                <control type="group">
                                    <left>164</left>
                                    <right>bigpad</right>
                                    <top>bigpad</top>
                                    <bottom>bigpad</bottom>
                                    <control type="label">
                                        <top>-8</top>
                                        <aligny>top</aligny>
                                        <height>30</height>
                                        <selectedcolor>ListLabel</selectedcolor>
                                        <label>$INFO[ListItem.ChannelNumberLabel,,. ]$INFO[ListItem.ChannelName]</label>
                                    </control>
                                    <control type="label">
                                        <top>22</top>
                                        <bottom>8</bottom>
                                        <aligny>center</aligny>
                                        <font>Font-ListInfo</font>
                                        <selectedcolor>ListLabel</selectedcolor>
                                        <label>$VAR[Label_IsRecording]$INFO[ListItem.Title]</label>
                                    </control>
                                    <control type="label">
                                        <top>22</top>
                                        <bottom>8</bottom>
                                        <aligny>center</aligny>
                                        <align>right</align>
                                        <font>Font-OSD</font>
                                        <selectedcolor>ListLabel</selectedcolor>
                                        <label>$INFO[ListItem.NextTitle,$LOCALIZE[31003]... ,]</label>
                                    </control>
                                    <control type="progress">
                                        <bottom>0</bottom>
                                        <height>8</height>
                                        <reveal>true</reveal>
                                        <info>ListItem.Progress</info>
                                        <lefttexture colordiffuse="5fededed">osd/progress-end.png</lefttexture>
                                        <midtexture colordiffuse="5fededed">osd/progress-end.png</midtexture>
                                    </control>
                                </control>
                            </control>
                        </itemlayout>

                        <focusedlayout height="144" width="listinfow">
                            <control type="group">
                                <left>0</left>
                                <right>0</right>
                                <include>Object_Background</include>
                                <control type="image">
                                    <width>100%</width>
                                    <height>100%</height>
                                    <texture colordiffuse="$VAR[HighlightColor]">common/white.png</texture>
                                </control>
                                <control type="image">
                                    <texture colordiffuse="0fffffff">common/selected.png</texture>
                                    <aspectratio>scale</aspectratio>
                                    <visible>ListItem.IsPlaying</visible>
                                </control>
                                <control type="image">
                                    <left>bigpad</left>
                                    <width>104</width>
                                    <top>bigpad</top>
                                    <bottom>bigpad</bottom>
                                    <aspectratio>keep</aspectratio>
                                    <texture background="true">$INFO[ListItem.Icon]</texture>
                                    <visible>!String.IsEmpty(ListItem.Icon)</visible>
                                </control>
                                <control type="image">
                                    <left>bigpad</left>
                                    <width>104</width>
                                    <top>bigpad</top>
                                    <bottom>bigpad</bottom>
                                    <aspectratio>keep</aspectratio>
                                    <texture background="true">$INFO[ListItem.Thumb]</texture>
                                    <visible>String.IsEmpty(ListItem.Icon)</visible>
                                </control>
                                <control type="group">
                                    <left>164</left>
                                    <right>bigpad</right>
                                    <top>bigpad</top>
                                    <bottom>bigpad</bottom>
                                    <control type="label">
                                        <top>-8</top>
                                        <aligny>top</aligny>
                                        <height>30</height>
                                        <selectedcolor>Selected</selectedcolor>
                                        <textcolor>Selected</textcolor>
                                        <label>$INFO[ListItem.ChannelNumberLabel,,. ]$INFO[ListItem.ChannelName]</label>
                                    </control>
                                    <control type="label">
                                        <top>22</top>
                                        <bottom>8</bottom>
                                        <aligny>center</aligny>
                                        <font>Font-ListInfo</font>
                                        <selectedcolor>Selected</selectedcolor>
                                        <textcolor>Selected</textcolor>
                                        <label>$VAR[Label_IsRecording]$INFO[ListItem.Title]</label>
                                    </control>
                                    <control type="label">
                                        <top>22</top>
                                        <bottom>8</bottom>
                                        <aligny>center</aligny>
                                        <align>right</align>
                                        <font>Font-OSD</font>
                                        <selectedcolor>Selected</selectedcolor>
                                        <textcolor>Selected</textcolor>
                                        <label>$INFO[ListItem.NextTitle,$LOCALIZE[31003]... ,]</label>
                                    </control>
                                    <control type="progress">
                                        <bottom>0</bottom>
                                        <height>8</height>
                                        <reveal>true</reveal>
                                        <info>ListItem.Progress</info>
                                        <lefttexture colordiffuse="Selected">osd/progress-end.png</lefttexture>
                                        <midtexture colordiffuse="Selected">osd/progress-end.png</midtexture>
                                    </control>
                                </control>
                            </control>
                        </focusedlayout>
                    </control>
                    <include content="Object_Scrollbar">
                        <param name="visible" value="Control.IsVisible(11)" />
                    </include>
                    <include>Object_Arrows_Vertical</include>
                </control>

                <!-- RECHTER BEREICH: Große InfoBox + DEMNÄCHST -->
                <include>PVR_InfoBox</include>
            </control>
        </control>
    </controls>
</window>
