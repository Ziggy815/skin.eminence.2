    <include name="PVR_InfoBox">
        <control type="group">
            <right>0</right>
            <width>720</width>
            <height>posterh</height>
            <!-- Current programme: header like ATV with title, timeline, metadata and plot -->
            <control type="group">
                <width>100%</width>
                <height>405</height>
                <include>Object_Background</include>
                <control type="grouplist">
                    <top>8</top>
                    <bottom>pad</bottom>
                    <left>pad</left>
                    <right>pad</right>
                    <itemgap>6</itemgap>
                    <orientation>vertical</orientation>
                    <usecontrolcoords>true</usecontrolcoords>
                    <!-- Main Show Title -->
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>44</height>
                        <font>Font-InfoBox-Title</font>
                        <textcolor>$VAR[HighlightColor2]</textcolor>
                        <scroll>true</scroll>
                        <label>$VAR[Label_IsRecording]$INFO[ListItem.Title]</label>
                        <visible>!String.IsEmpty(ListItem.Title)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>44</height>
                        <font>Font-InfoBox-Title</font>
                        <textcolor>$VAR[HighlightColor2]</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEmpty(ListItem.Title) + !String.IsEmpty(ListItem.Label)</visible>
                    </control>
                    <!-- Episode Title (Prioritize EpisodeName, then OriginalTitle if not equal to Title) -->
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo</font>
                        <textcolor>MainLabel</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.EpisodeName]$INFO[ListItem.Year, (,)]$INFO[ListItem.Duration(mins), · , min]</label>
                        <visible>!String.IsEmpty(ListItem.EpisodeName)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo</font>
                        <textcolor>MainLabel</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.OriginalTitle]$INFO[ListItem.Year, (,)]$INFO[ListItem.Duration(mins), · , min]</label>
                        <visible>String.IsEmpty(ListItem.EpisodeName) + !String.IsEmpty(ListItem.OriginalTitle) + !String.IsEqual(ListItem.OriginalTitle,ListItem.Title)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo</font>
                        <textcolor>MainLabel</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Year,(,)][COLOR=SubLabel]$INFO[ListItem.Duration(mins), · , min][/COLOR]</label>
                        <visible>String.IsEmpty(ListItem.EpisodeName) + [String.IsEmpty(ListItem.OriginalTitle) | String.IsEqual(ListItem.OriginalTitle,ListItem.Title)] + !String.IsEmpty(ListItem.Year)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo</font>
                        <textcolor>SubLabel</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Duration(mins),, min]</label>
                        <visible>String.IsEmpty(ListItem.EpisodeName) + [String.IsEmpty(ListItem.OriginalTitle) | String.IsEqual(ListItem.OriginalTitle,ListItem.Title)] + String.IsEmpty(ListItem.Year) + !String.IsEmpty(ListItem.Duration) + !String.IsEqual(ListItem.Duration,0)</visible>
                    </control>
                    <!-- Season / Episode (Localized: Staffel X, Episode/Folge Y) -->
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo-Small-Bold</font>
                        <textcolor>SubLabel</textcolor>
                        <label>$INFO[ListItem.Season,$LOCALIZE[20373] ,]$INFO[ListItem.Episode, · $LOCALIZE[20359] ,]</label>
                        <visible>!String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode)</visible>
                        <visible>!String.Contains(ListItem.Genre,Film) + !String.Contains(ListItem.Genre,Movie)</visible>
                        <visible>!String.IsEmpty(ListItem.EpisodeName) | Integer.IsGreater(ListItem.Season,1) | Integer.IsGreater(ListItem.Episode,1)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo-Small-Bold</font>
                        <textcolor>SubLabel</textcolor>
                        <label>$INFO[ListItem.Season,$LOCALIZE[20373] ,]</label>
                        <visible>!String.IsEmpty(ListItem.Season) + String.IsEmpty(ListItem.Episode)</visible>
                        <visible>!String.Contains(ListItem.Genre,Film) + !String.Contains(ListItem.Genre,Movie)</visible>
                        <visible>!String.IsEmpty(ListItem.EpisodeName) | Integer.IsGreater(ListItem.Season,1)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <right>0</right>
                        <height>28</height>
                        <font>Font-ListInfo-Small-Bold</font>
                        <textcolor>SubLabel</textcolor>
                        <label>$INFO[ListItem.Episode,$LOCALIZE[20359] ,]</label>
                        <visible>String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode)</visible>
                        <visible>!String.Contains(ListItem.Genre,Film) + !String.Contains(ListItem.Genre,Movie)</visible>
                        <visible>!String.IsEmpty(ListItem.EpisodeName) | Integer.IsGreater(ListItem.Episode,1)</visible>
                    </control>
                    <!-- Timeline + Progress bar: only in Live TV / Radio Channels view -->
                    <control type="group">
                        <left>0</left>
                        <right>0</right>
                        <height>48</height>
                        <visible>!String.IsEmpty(ListItem.StartTime) + [Window.IsVisible(TVChannels) | Window.IsVisible(RadioChannels) | Window.IsVisible(DialogPVRChannelsOSD.xml)]</visible>
                        <control type="label">
                            <top>0</top>
                            <left>0</left>
                            <width>330</width>
                            <height>28</height>
